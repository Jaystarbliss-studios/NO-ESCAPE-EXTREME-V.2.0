rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // Validation Blueprint: UserProgress (/users/{userId})
    function isValidUserProgress(data) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'highestUnlockedLevel',
        'completedLevels',
        'coins',
        'unlockedCosmetics',
        'equippedSkin',
        'equippedTrail',
        'equippedPortalStyle',
        'dailyBestDate',
        'dailyBestTimeMs',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'displayName',
        'highestUnlockedLevel',
        'completedLevels',
        'coins',
        'unlockedCosmetics',
        'equippedSkin',
        'equippedTrail',
        'equippedPortalStyle',
        'dailyBestDate',
        'dailyBestTimeMs',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string &&
      data.uid.size() >= 1 &&
      data.uid.size() <= 128 &&
      data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.uid == request.auth.uid &&
      data.displayName is string &&
      data.displayName.size() >= 1 &&
      data.displayName.size() <= 40 &&
      data.highestUnlockedLevel is int &&
      data.highestUnlockedLevel >= 1 &&
      data.highestUnlockedLevel <= 100 &&
      data.completedLevels is list &&
      data.completedLevels.size() <= 100 &&
      (data.completedLevels.size() == 0 || data.completedLevels[0] is int) &&
      data.coins is int &&
      data.coins >= 0 &&
      data.coins <= 10000000 &&
      data.unlockedCosmetics is list &&
      data.unlockedCosmetics.size() >= 1 &&
      data.unlockedCosmetics.size() <= 20 &&
      data.unlockedCosmetics[0] is string &&
      data.unlockedCosmetics[0].size() <= 32 &&
      data.equippedSkin is string &&
      data.equippedSkin.size() >= 1 &&
      data.equippedSkin.size() <= 32 &&
      data.equippedTrail is string &&
      data.equippedTrail.size() >= 1 &&
      data.equippedTrail.size() <= 32 &&
      data.equippedPortalStyle is string &&
      data.equippedPortalStyle.size() >= 1 &&
      data.equippedPortalStyle.size() <= 32 &&
      data.dailyBestDate is string &&
      data.dailyBestDate.size() <= 10 &&
      data.dailyBestTimeMs is int &&
      data.dailyBestTimeMs >= 0 &&
      data.dailyBestTimeMs <= 3600000 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: DailyLeaderboardEntry (/dailyLeaderboards/{entryId})
    function isValidDailyLeaderboardEntry(data) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'dateKey',
        'seed',
        'clearTimeMs',
        'coinsCollected',
        'damageTaken',
        'skinId',
        'isPublic',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'displayName',
        'dateKey',
        'seed',
        'clearTimeMs',
        'coinsCollected',
        'damageTaken',
        'skinId',
        'isPublic',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string &&
      data.uid.size() >= 1 &&
      data.uid.size() <= 128 &&
      data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.uid == request.auth.uid &&
      data.displayName is string &&
      data.displayName.size() >= 1 &&
      data.displayName.size() <= 40 &&
      data.dateKey is string &&
      data.dateKey.size() == 10 &&
      data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      data.seed is int &&
      data.clearTimeMs is int &&
      data.clearTimeMs >= 1000 &&
      data.clearTimeMs <= 3600000 &&
      data.coinsCollected is int &&
      data.coinsCollected >= 0 &&
      data.coinsCollected <= 500 &&
      data.damageTaken is int &&
      data.damageTaken >= 0 &&
      data.damageTaken <= 100 &&
      data.skinId is string &&
      data.skinId.size() >= 1 &&
      data.skinId.size() <= 32 &&
      data.isPublic is bool &&
      data.isPublic == true &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Collection 1: Private Cloud User Progress
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProgress(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProgress(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'highestUnlockedLevel',
          'completedLevels',
          'coins',
          'unlockedCosmetics',
          'equippedSkin',
          'equippedTrail',
          'equippedPortalStyle',
          'dailyBestDate',
          'dailyBestTimeMs',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // Collection 2: Global Daily Challenge Leaderboard
    match /dailyLeaderboards/{entryId} {
      allow get: if isValidId(entryId) && resource.data.isPublic == true;
      allow list: if resource.data.isPublic == true;
      allow create: if isVerifiedUser() &&
        isValidId(entryId) &&
        isValidDailyLeaderboardEntry(incoming()) &&
        entryId == incoming().dateKey + '_' + request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(entryId) &&
        isValidDailyLeaderboardEntry(incoming()) &&
        existing().uid == request.auth.uid &&
        incoming().uid == existing().uid &&
        incoming().dateKey == existing().dateKey &&
        incoming().seed == existing().seed &&
        incoming().isPublic == existing().isPublic &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().clearTimeMs <= existing().clearTimeMs &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'clearTimeMs',
          'coinsCollected',
          'damageTaken',
          'skinId',
          'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
